# Copy to .env (gitignored) — NEVER commit real values.
# RPC endpoint of the target network (e.g. an Alchemy/Infura/own-node URL)
RPC_URL=
# Etherscan-compatible explorer API key for `forge verify-contract`
ETHERSCAN_API_KEY=
# Must equal the target chain id for non-dev deploys (fail-closed guard)
EXPECTED_CHAIN_ID=
# Genesis Merkle root (`tcl ledger root`) and time
GENESIS_ROOT=
GENESIS_TIME=
THRESHOLD=5000000
RATE_PER_SECOND=0
# Timelock / multisig that will own the proxy (contract address; required off dev chains)
FINAL_OWNER=
SETTLER=
# Set to true ONLY after the verifier was regenerated from a public MPC ceremony zkey
VERIFIER_CEREMONY_ATTESTED=false
# The deployer key is NOT configured here: use `cast wallet import deployer --interactive`
# and pass `--account deployer` to forge. TCL_CHAIN_PRIVATE_KEY is for the settler daemon
# only and should come from a secret manager, not this file.
