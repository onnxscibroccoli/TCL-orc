# Copy to .env and adjust. All keys are optional.
TCL_DB=./tcl.db
TCL_LOG_LEVEL=WARNING
TCL_MODE=fixed
TCL_TREE_DEPTH=20
# TCL_CONFIG=./config.yaml
# daemon / zk / chain
# TCL_SOCKET=.tcl/daemon.sock
# TCL_TASKS_DB=.tcl/tasks.db
# TCL_HTTP_HOST=127.0.0.1
# TCL_HTTP_PORT=8787
# TCL_ZK_BUILD=.tcl/zk
# TCL_ZK_DEPTH=4
# TCL_RPC_URL=http://127.0.0.1:8545
# TCL_CHAIN_PRIVATE_KEY=0x...   # defaults to the public anvil dev key; never commit a real key
