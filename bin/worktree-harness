#!/usr/bin/env bash
# Thin compatibility shim: all logic lives in the Python CLI (tcl-cli worktree ...).
# Usage: worktree-harness {create|remove|list|prune|health} [branch-name]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if command -v tcl-cli >/dev/null 2>&1; then cli=(tcl-cli)
else cli=(env "PYTHONPATH=${here}/src${PYTHONPATH:+:$PYTHONPATH}" python3 -m tcl.cli); fi
cmd="${1:-}"; shift || true
case "$cmd" in
    create|remove) [ -z "${1:-}" ] && { echo "Usage: $0 $cmd <branch>" >&2; exit 1; }
                   exec "${cli[@]}" worktree "$cmd" "$@" --repo . ;;
    list|health)   exec "${cli[@]}" worktree "$cmd" --repo . ;;
    prune)         exec git worktree prune ;;
    *) echo "Usage: $0 {create|remove|list|prune|health} [branch-name]" >&2; exit 1 ;;
esac
