// SPDX-License-Identifier: Apache-2.0
// TCL in-house Poseidon permutation over BN254 (clean-room; not derived from circomlib).
// Straightforward HADES schedule from the Poseidon paper (Grassi et al., 2019):
// x^5 S-box, R_F = 8 full rounds, R_P in {56,57,56,60} partial rounds for t = 2..5,
// state[0] = 0 (capacity), state[1..] = inputs, output = state[0] after the permutation.
// Constants: poseidon_constants.circom, generated by scripts/gen_poseidon_constants.py.
pragma circom 2.1.6;

include "poseidon_constants.circom";

template Sigma() {
    signal input in;
    signal output out;
    signal x2;
    signal x4;
    x2 <== in * in;
    x4 <== x2 * x2;
    out <== x4 * in;
}

template Poseidon(nInputs) {
    assert(nInputs >= 1 && nInputs <= 4);
    signal input inputs[nInputs];
    signal output out;

    var t = nInputs + 1;
    var RF = 8;
    var RPS[4] = [56, 57, 56, 60];
    var RP = RPS[t - 2];
    var R = RF + RP;
    var C[R * t] = TCL_POSEIDON_C(t);
    var M[t][t] = TCL_POSEIDON_M(t);

    // st[r] = state entering round r (linear expressions are materialised as signals).
    signal st[R + 1][t];
    component sb[R][t];
    st[0][0] <== 0;
    for (var i = 1; i < t; i++) st[0][i] <== inputs[i - 1];

    for (var r = 0; r < R; r++) {
        var full = (r < RF / 2) || (r >= RF / 2 + RP);
        var y[t];
        for (var i = 0; i < t; i++) {
            if (full || i == 0) {
                sb[r][i] = Sigma();
                sb[r][i].in <== st[r][i] + C[r * t + i];
                y[i] = sb[r][i].out;
            } else {
                y[i] = st[r][i] + C[r * t + i];
            }
        }
        for (var i = 0; i < t; i++) {
            var acc = 0;
            for (var j = 0; j < t; j++) acc += M[i][j] * y[j];
            st[r + 1][i] <== acc;
        }
    }
    out <== st[R][0];
}
